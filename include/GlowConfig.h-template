// LedService
#define LED_DATA_PIN 3
#define LED_NUM_LEDS 11
#define LED_MAX_BRIGHTNESS 255
#define LED_MIN_BRIGHTNESS 0
#define LED_DEFAULT_BRIGHTNESS 128

#define LED_UPDATE_STEPS 20
#define LED_UPDATE_STEPS_MIN 5
#define LED_UPDATE_STEPS_MAX 55

// Button
#define BUTTON_PIN 4

// NetworkService
#define WIFI_ON false
#define WIFI_SSID ""
#define WIFI_PASSWORD ""
#define GLOW_HOSTNAME "glowlight"
// Hold the hardware button during boot to open the setup access point. The
// password must be unique and 8-63 characters when the portal is enabled.
#define GLOW_PORTAL_ENABLED false
#define GLOW_PORTAL_PASSWORD "PROVISION_WITH_SETUP"

// Password-protected firmware updates over infrastructure WiFi. OTA uses a
// separate credential from the captive portal and is disabled by default.
#define GLOW_OTA_ENABLED false
#define GLOW_OTA_PASSWORD "PROVISION_WITH_SETUP"

// Home Assistant over MQTT. Needs infrastructure WiFi and a broker; entities
// are generated from the modes the firmware was built with.
#define GLOW_MQTT_ENABLED false
#define GLOW_MQTT_HOST ""
#define GLOW_MQTT_PORT 1883
#define GLOW_MQTT_USER ""
#define GLOW_MQTT_PASSWORD ""
#define GLOW_MQTT_DISCOVERY_PREFIX "homeassistant"

// CommunicationService
#define MESH_ON false
#define GLOW_SYNC_FOLLOW_DEFAULT true
#define GLOW_SYNC_PUBLISH_DEFAULT true
// Fallback channel used while no WiFi connection exists. With WiFi enabled the
// access point dictates the channel, so all lamps of a group must share one AP.
#define ESPNOW_CHANNEL 1           // WiFi channel (1-13), configurable
#define GLOW_GROUP_KEY_HEX "PROVISION_WITH_SETUP"
#define GLOW_MAX_GROUP_NODES 8
#define GLOW_NODE_TIMEOUT 30*60*1000 // 30 minutes
#define HARTBEAT_INTERVAL 10000
#define LEVEL_UPDATE_INTERVAL 100  // ms - max 10 updates/sec for live dimming

// DistanceService
#define DISTANCE_SENSOR_SDA 6
#define DISTANCE_SENSOR_SCL 7

#define DISTANCE_TIMEOUT_MS 500
#define DISTANCE_TIMING_BUDGET_MS 20
#define DISTANCE_THRESHOLD_MM 10

#define DISTANCE_LEVELS 255

#define DISTANCE_MIN_MM 50
#define DISTANCE_MAX_MM 200
#define DISTANCE_UNCHANGED_MM 500

#define DISTANCE_HOLD_MS 1000

#define DISTANCE_HOLD_STATUS 0x02
#define DISTANCE_RELEASE_STATUS 0x00
#define DISTANCE_CHANGING_STATUS 0x01

#define QUICK_WIPE_MEASUREMENTS 3
#define QUICK_WIPE_MAX 10
#define QUICK_WIPE_TIMEOUT 700

// Alert
#define ALERT_NUM_FLASHES 5
#define ALERT_SPEED_STEP 32

// RainbowMode
#define RAINBOW_SPEED_MAX 1
#define RAINBOW_SPEED_MIN 20
#define RAINBOW_SPEED_DEFAULT 4

#define RAINBOW_SATURATION_DEFAULT 255

// CandleMode
#define CANDLE_SPEED_MIN 1
#define CANDLE_SPEED_MAX 100
#define CANDLE_SPEED_DEFAULT 5

// MiniGame
#define MINIGAME_SPEED_MIN 2
#define MINIGAME_SPEED_MAX 11
#define MINIGAME_SPEED_DEFAULT 5

// BeaconMode
#define BEACON_SPEED_MAX 2
#define BEACON_SPEED_MIN 10
#define BEACON_SPEED_DEFAULT 5

#define BEACON_LENGTH_DEFAULT LED_NUM_LEDS / 2
